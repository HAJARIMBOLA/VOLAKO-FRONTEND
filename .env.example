# Environment variables for production deployment (e.g. Vercel).
# Never commit real values — set these in your hosting provider's dashboard.

# URL of the deployed VOLAKO Spring Boot backend (server-side only, never exposed
# to the browser). Locally: http://localhost:8080. In production: your Render URL,
# e.g. https://volako-backend.onrender.com
BACKEND_URL=http://localhost:8080

# NODE_ENV is set automatically by Next.js/Vercel — do not set it manually.
# It controls the secure cookie flag (httpOnly cookies require HTTPS in production).
